{
  "name": "ml-intern-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "HuggingChat's ML Intern Hub tools for your own sandbox, over stdio or Streamable HTTP",
  "type": "module",
  "bin": {
    "ml-intern-mcp": "./server.mjs"
  },
  "main": "./generated/tools.mjs",
  "types": "./generated/tools.d.mts",
  "files": [
    "server.mjs",
    "lib",
    "generated",
    "openapi.yaml",
    "scripts/check-sandbox.mjs",
    "skills/ml-intern",
    "notices"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "start:http": "node server.mjs --http",
    "check:sandbox": "node scripts/check-sandbox.mjs",
    "capture": "node scripts/capture-contract.mjs",
    "check:drift": "node scripts/capture-contract.mjs --check && node scripts/generate.mjs --check && node scripts/check-drift.mjs",
    "generate": "node scripts/generate.mjs",
    "test": "node scripts/generate.mjs --check && tsc --noEmit --strict --module nodenext --target es2022 test/types.mts && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@llmindset/hf-mcp-server": "0.4.39",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0"
  },
  "devDependencies": {
    "@llmindset/hf-mcp": "0.4.39",
    "@modelcontextprotocol/core": "2.4.0",
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1",
    "zod": "4.6.6"
  }
}
