{
  "credentialEnvironment": [
    "MODAL_TOKEN_ID",
    "MODAL_TOKEN_SECRET"
  ],
  "calls": [
    {
      "name": "sandbox_status",
      "arguments": {
        "provider": "modal",
        "sandboxId": "sb-1234567890abcdefghijkl"
      }
    },
    {
      "name": "sandbox_exec",
      "arguments": {
        "provider": "modal",
        "sandboxId": "sb-1234567890abcdefghijkl",
        "command": "printf ml-intern-ok",
        "timeoutSeconds": 10
      }
    }
  ],
  "illustrativeResults": [
    {
      "provider": "modal",
      "sandboxId": "sb-1234567890abcdefghijkl",
      "state": "running"
    },
    {
      "provider": "modal",
      "sandboxId": "sb-1234567890abcdefghijkl",
      "stdout": "ml-intern-ok",
      "stderr": "",
      "exitCode": 0,
      "timedOut": false
    }
  ],
  "fileCalls": [
    {
      "name": "sandbox_write_file",
      "arguments": {
        "provider": "modal",
        "sandboxId": "sb-1234567890abcdefghijkl",
        "path": "/tmp/ml-intern-example.txt",
        "text": "hello\n"
      }
    },
    {
      "name": "sandbox_read_file",
      "arguments": {
        "provider": "modal",
        "sandboxId": "sb-1234567890abcdefghijkl",
        "path": "/tmp/ml-intern-example.txt",
        "maxBytes": 256
      }
    }
  ],
  "illustrativeFileResults": [
    {
      "provider": "modal",
      "sandboxId": "sb-1234567890abcdefghijkl",
      "bytes": 6
    },
    {
      "provider": "modal",
      "sandboxId": "sb-1234567890abcdefghijkl",
      "text": "hello\n",
      "bytes": 6,
      "truncated": false
    }
  ]
}
